# Copy these into Vercel → Project → Settings → Environment Variables.
# Apply to Production, Preview, and Development unless noted.
# After the first deploy, set NEXT_PUBLIC_SITE_URL and BETTER_AUTH_URL
# to the real https:// origin (custom domain or *.vercel.app).

# --- Neon / Postgres (Vercel Storage → Neon fills most of these) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# --- App ---
# Production: https://your-domain.com  | Preview can stay unset (uses VERCEL_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APPLICATION_DEADLINE=2026-09-04
# Vercel Functions cap the whole request at 4.5 MB. Keep this at 1 on Vercel
# (three files + form fields). Local default is 8 if unset.
NEXT_PUBLIC_MAX_UPLOAD_MB=1
CONTACT_EMAIL=replusevent@amchammali.org
APPLICATION_DEADLINE=2026-09-04
MAX_UPLOAD_MB=1
RESEND_API_KEY=
MAIL_FROM=

# --- Reviewer access (espace équipe) ---
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
# openssl rand -base64 32
AUTH_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Dedicated docs key. Set once and never rotate or existing files will not decrypt.
# openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=
